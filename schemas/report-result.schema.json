{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/37chengshan/eduevidence/schemas/report-result.schema.json",
  "title": "ReportResult",
  "description": "Validated result.json contract (总体实施计划 §27). Produced by the EduEvidence research core, consumed by the visualization layer. The report layer may choose HOW to present but must never change this data. claims 每条必须携带 claim_id（C-001 格式，Claim-Evidence Contract）。扩展字段一律放在各对象 extensions 内。",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "research_frame", "decision", "evidence"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill"],
      "properties": {
        "skill": { "type": "string", "const": "eduevidence" },
        "version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "mode": { "type": "string", "enum": ["platform_native", "agent_mcp_enhanced"] },
        "question": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "description": "How this result was produced: complexity grade, agent topology, token/cost usage.",
      "properties": {
        "complexity": { "type": "string", "enum": ["S", "M", "L"] },
        "mode": { "type": "string", "enum": ["platform_native", "agent_mcp_enhanced"] },
        "agents": { "type": "array", "items": { "type": "string" } },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurement_status"],
          "description": "Token/cost usage. Unknown values are null with measurement_status=NOT_CAPTURED; never fabricate 0 as a real measurement (P1-3).",
          "properties": {
            "measurement_status": { "type": "string", "enum": ["NOT_CAPTURED"], "description": "NOT_CAPTURED: usage was not measured by the pipeline." },
            "input_tokens": { "type": ["integer", "null"] },
            "output_tokens": { "type": ["integer", "null"] },
            "cost_usd": { "type": ["number", "null"] },
            "latency_s": { "type": ["number", "null"] }
          }
        }
      }
    },
    "research_frame": { "type": "object", "description": "EducationResearchFrame (see education-frame.schema.json)." },
    "decision": { "type": "object", "description": "EducationVerdict (see verdict.schema.json)." },
    "outcomes": {
      "type": "array",
      "description": "Outcome-level aggregation: per outcome type, effect_direction counts (positive/negative/null) and evidence ids.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome_type": { "type": "string" },
          "positive_count": { "type": "integer" },
          "negative_count": { "type": "integer" },
          "null_count": { "type": "integer" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Claim-level rows bound to evidence (Claim-Evidence Contract).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^C-[0-9]{3}$", "examples": ["C-001"] },
          "claim": { "type": "string" },
          "outcome_type": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["SUPPORTED", "UNSUPPORTED", "DOWNGRADE_CONFIDENCE", "CONTRADICT"] }
        }
      }
    },
    "sources": { "type": "array", "description": "Source Objects (see source.schema.json)." },
    "evidence": { "type": "array", "description": "Evidence Objects (see evidence.schema.json)." },
    "methodology_reviews": { "type": "array", "description": "MethodologyAudit objects (see methodology.schema.json)." },
    "conflicts": {
      "type": "array",
      "description": "Conflict analysis entries (why studies disagree).",
      "items": { "type": "object", "additionalProperties": true }
    },
    "applicability": { "type": "object", "additionalProperties": true },
    "intervention": { "type": "object", "description": "TeachingIntervention (see intervention.schema.json)." },
    "evaluation": { "type": "object", "description": "EvaluationPlan (see evaluation.schema.json)." },
    "benchmark": { "type": "object", "additionalProperties": true, "description": "Benchmark metrics for this result (optional)." },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fetch/search provenance (Smart Web Fetch v3 §6): sources must carry fetch provenance.",
      "properties": {
        "search_provider": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "fetch_summary": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
