{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/37chengshan/eduevidence/schemas/report-spec.schema.json",
  "title": "ReportSpec",
  "description": "report_spec.json — the Visualization Planner output (v5 方案 §9-10, §36). Declares sections and components from the frozen Component Catalog; the deterministic renderer turns it into HTML. No free-form DOM.",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "theme", "sections"],
  "properties": {
    "title": { "type": "string" },
    "theme": {
      "type": "string",
      "enum": ["claude", "academic", "editorial", "datalab", "presentation"]
    },
    "mode": { "type": "string", "enum": ["research", "demo"], "default": "research" },
    "generated_at": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "component"],
        "properties": {
          "id": { "type": "string", "examples": ["01-executive-decision"] },
          "title": { "type": "string" },
          "component": {
            "type": "string",
            "enum": [
              "ReportShell", "Section", "DecisionCard", "ConfidenceBadge",
              "OutcomeSummary", "InteractiveChart", "AcademicFigure",
              "InfographicBlock", "EvidenceMatrix", "EvidenceRow",
              "TribunalView", "MethodologyPanel", "ConflictCard",
              "ClaimTrace", "ApplicabilityCard", "InterventionTimeline",
              "EvaluationFlow", "BenchmarkPanel", "SourceList",
              "ProvenancePanel", "Footnote"
            ]
          },
          "data_ref": { "type": "string", "description": "Pointer into result.json (e.g. 'decision', 'evidence', 'sources')." },
          "props": { "type": "object", "description": "Component props (theme-agnostic)." }
        }
      }
    },
    "charts": {
      "type": "array",
      "description": "Chart declarations (see chart-spec.schema.json).",
      "items": { "$ref": "chart-spec.schema.json" }
    },
    "integrity": {
      "type": "object",
      "description": "Scientific Integrity Gate result (v5 方案 §27).",
      "properties": {
        "status": { "type": "string", "enum": ["VALID", "REPORT_INVALID"] },
        "checks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
