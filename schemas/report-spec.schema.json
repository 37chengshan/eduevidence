{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/37chengshan/eduevidence/schemas/report-spec.schema.json",
  "title": "ReportSpec",
  "description": "report_spec.json — the Visualization Planner output (v5 方案 §9-10, §36). Declares sections and components from the frozen Component Catalog; the deterministic renderer turns it into HTML. No free-form DOM. 扩展字段一律放在各对象 extensions 内。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "theme",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "claude",
        "academic",
        "datalab",
        "datalab-dark",
        "presentation"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "research",
        "demo"
      ],
      "default": "research"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "component"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "01-executive-decision"
            ]
          },
          "title": {
            "type": "string"
          },
          "component": {
            "type": "string",
            "enum": [
              "ReportShell",
              "Section",
              "DecisionCard",
              "ConfidenceBadge",
              "OutcomeSummary",
              "InteractiveChart",
              "AcademicFigure",
              "InfographicBlock",
              "EvidenceMatrix",
              "EvidenceRow",
              "TribunalView",
              "MethodologyPanel",
              "ConflictCard",
              "ClaimTrace",
              "ApplicabilityCard",
              "InterventionTimeline",
              "EvaluationFlow",
              "BenchmarkPanel",
              "SourceList",
              "ProvenancePanel",
              "Footnote"
            ]
          },
          "data_ref": {
            "type": "string",
            "description": "Pointer into result.json (e.g. 'decision', 'evidence', 'sources')."
          },
          "props": {
            "type": "object",
            "additionalProperties": true,
            "description": "Component props (theme-agnostic)."
          }
        }
      }
    },
    "charts": {
      "type": "array",
      "description": "Chart declarations (see chart-spec.schema.json).",
      "items": {
        "$ref": "chart-spec.schema.json"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scientific Integrity Gate result (v5 方案 §27).",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VALID",
            "REPORT_INVALID"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "结构化扩展字段的统一容器（P1-01）。未列入本 schema 的字段必须放在这里，禁止在顶层新增属性。",
      "additionalProperties": true
    }
  }
}
