{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/37chengshan/eduevidence/schemas/chart-spec.schema.json",
  "title": "ChartSpec",
  "description": "Chart spec produced by visualization build_charts.py. integrity is a per-check map with PASS/FAIL/NOT_CHECKED strings (P0-2 rewrite to match the real producer).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chart_id",
    "purpose",
    "engine",
    "chart_type"
  ],
  "properties": {
    "chart_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "echarts",
        "svg"
      ]
    },
    "chart_type": {
      "type": "string",
      "minLength": 1
    },
    "semantic_basis": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "option": {
      "type": "object",
      "additionalProperties": true
    },
    "summary_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numbers_match_result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_CHECKED"
          ]
        },
        "no_axis_distortion": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_CHECKED"
          ]
        },
        "no_false_precision": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_CHECKED"
          ]
        },
        "colorblind_safe": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_CHECKED"
          ]
        }
      }
    }
  }
}
