{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/37chengshan/eduevidence/schemas/source.schema.json",
  "title": "SourceObject",
  "description": "Unified source registry entry (总体实施计划 §11 / v3 方案 §14). Evidence Objects reference only source_id. Fetch provider is a reading path, never the citation target. 扩展字段一律放在 extensions 内。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "canonical_url",
    "authority_level"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "examples": [
        "S-2023-kazemitabaar"
      ]
    },
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "doi": {
      "type": "string",
      "examples": [
        "10.1145/3544548.3580919"
      ]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "source_location": {
      "type": "string",
      "format": "uri",
      "description": "Legacy alias of the canonical citation pointer (kept for backward compatibility)."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "paper",
        "journal_article",
        "conference_paper",
        "report",
        "institution_page",
        "dataset",
        "thesis",
        "news",
        "web_page",
        "pdf",
        "other"
      ]
    },
    "authority_level": {
      "type": "string",
      "enum": [
        "tier1_paper_doi",
        "tier2_academic_database",
        "tier3_professional_institution",
        "tier4_news_secondary",
        "tier5_general_web"
      ],
      "description": "学术来源优先级（v3 方案 §9）：Tier 1-5。fetch provider 不能提升此值。"
    },
    "discovered_by": {
      "type": "string",
      "examples": [
        "scholar_search",
        "web_search"
      ]
    },
    "discovery_provider": {
      "type": "string",
      "examples": [
        "SCP",
        "Scholar-KG",
        "bing"
      ]
    },
    "source_locator": {
      "type": "object",
      "description": "精确定位引用内容在源中的位置（P1-03）。type/page/section/paragraph/quote_hash 均可选，但至少应能据此复核原文。",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "page",
            "section",
            "paragraph",
            "quote",
            "supplement",
            "other"
          ]
        },
        "page": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "section": {
          "type": "string"
        },
        "paragraph": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "quote_hash": {
          "type": "string",
          "description": "SHA-256 或等价指纹，对引用的原文片段计算。"
        }
      }
    },
    "fetch": {
      "$ref": "#/definitions/fetchProvenance"
    },
    "content_hash": {
      "type": "string"
    },
    "dedupe_keys": {
      "type": "object",
      "additionalProperties": false,
      "description": "去重键（v3 方案 §13）：canonical_url / doi / title fingerprint / content_hash",
      "properties": {
        "canonical_url": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "title_fingerprint": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "FETCHED",
        "VALID",
        "PARTIAL",
        "FAILED",
        "DUPLICATE",
        "INVALID"
      ]
    },
    "extensions": {
      "type": "object",
      "description": "结构化扩展字段的统一容器（P1-01）。未列入本 schema 的字段必须放在这里，禁止在顶层新增属性。",
      "additionalProperties": true
    },
    "doi_verified": {
      "type": "boolean",
      "description": "True when the DOI resolved against Crossref/DataCite and the registered title matches (engine.citation_check)."
    },
    "retracted": {
      "type": "boolean",
      "description": "True when the registry marks this work as retracted."
    }
  },
  "definitions": {
    "fetchProvenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fetch Provenance（v3 方案 §6，P1-06）：清洗服务只是读取路径，真正的证据来源仍是原始 URL/论文。fetch_status 必填：只有 FETCH_VALID（或规则确认的 FETCH_PARTIAL）可进入证据提取。",
      "required": [
        "fetch_status"
      ],
      "properties": {
        "original_url": {
          "type": "string",
          "format": "uri"
        },
        "resolved_url": {
          "type": "string",
          "format": "uri"
        },
        "fetch_method": {
          "type": "string",
          "enum": [
            "native",
            "smart_web_fetch"
          ]
        },
        "fetch_provider": {
          "type": "string",
          "enum": [
            "builtin",
            "jina_reader",
            "markdown_new",
            "defuddle",
            "raw_html",
            "pdf_parser"
          ]
        },
        "fetch_status": {
          "type": "string",
          "enum": [
            "FETCH_VALID",
            "FETCH_PARTIAL",
            "FETCH_FAILED"
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string"
        },
        "content_length": {
          "type": "integer",
          "minimum": 0
        },
        "raw_size": {
          "type": "integer",
          "minimum": 0
        },
        "clean_size": {
          "type": "integer",
          "minimum": 0
        },
        "compression_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fallback_used": {
          "type": "boolean",
          "default": false
        },
        "fallback_chain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "实际尝试过的 provider 降级链（按顺序）。"
        },
        "content": {
          "type": "string",
          "description": "清洗后的正文（Markdown/文本），仅 FETCH_VALID/PARTIAL 时携带。"
        },
        "status_code": {
          "type": "integer",
          "description": "最终响应 HTTP 状态码（含 redirect 后）。"
        },
        "content_type": {
          "type": "string",
          "description": "最终响应的 Content-Type，如 text/html; charset=utf-8、application/pdf。"
        },
        "charset": {
          "type": "string"
        },
        "response_headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "最终响应头（供审计，不参与证据判断）。"
        },
        "validation": {
          "type": "object",
          "additionalProperties": true,
          "description": "Fetch Validation Gate 结果（validate_fetch_result 输出）。",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "checks": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}